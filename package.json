{
  "name": "jaysbadminton",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "hono": "^4.13.12",
    "pinyin-pro": "^3.29.4",
    "postal-mime": "^4.0.2",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/qrcode": "^1.5.6",
    "preact-render-to-string": "^6.8.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.145.0"
  }
}
