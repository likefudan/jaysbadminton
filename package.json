{
  "name": "jaysbadminton",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "pinyin-pro": "^3.29.5",
    "postal-mime": "^4.2.0",
    "preact": "^11.1.0",
    "preact-iso": "^2.12.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/qrcode": "^1.5.6",
    "preact-render-to-string": "^6.8.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  }
}
