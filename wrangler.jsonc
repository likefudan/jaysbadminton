{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaysbadminton",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  // An address that is no file goes to the Worker, which answers with the app for a page and with a
  // 404 for anything else (index.ts): Cloudflare's own single-page fallback would hand the app's HTML
  // to a request for a script that is gone, and under /assets/ that answer would be kept for a year.
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/e/*", "/robots.txt", "/manifest.webmanifest", "/.well-known/*", "/api/*", "/export/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaysbadminton",
      // Filled in by CI from the account's D1 database list; this placeholder works for local dev and tests.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // ORGANIZERS: the 管理员 and 组织者 features, on in production since 2026-10-21. Emergency switch-off: set "0"
  // and release (docs/launch-checklist.md, section 五). Local dev turns them on with ORGANIZERS="1" in .dev.vars.
  "vars": {
    "SITE_ORIGIN": "https://jaysbadminton.llmat.dev",
    "ENVIRONMENT": "production",
    "ORGANIZERS": "1",
    "SPONSOR_NAME": "Z3 Enterprise",
    "SPONSOR_URL": "https://www.z3enterprise.com/"
  },
  // 截止前提醒 and 报名截止 go out on time from each event's alarm (src/worker/deadlines.ts);
  // PUSH sends a backlog of member pushes one batch a second (src/worker/push.ts).
  "durable_objects": {
    "bindings": [{ "name": "DEADLINES", "class_name": "DeadlineAlarm" }, { "name": "PUSH", "class_name": "PushSender" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DeadlineAlarm"] },
    { "tag": "v2", "new_sqlite_classes": ["PushSender"] }
  ],
  // Every 15 minutes: the hourly and daily jobs (settle reminder, dunning, digest) and a backstop
  // for any alarm that failed. Every job is logged in notification_log, so nothing is sent twice.
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [{ "pattern": "jaysbadminton.llmat.dev", "custom_domain": true }],
  "observability": { "enabled": true },
  // The databases live in US East (D1 region ENAM) while members are in the Bay Area: run the Worker
  // next to the database, so a request crosses the country once instead of once per query. Smart
  // Placement ("mode": "smart") was tried first and left the Worker where the visitor is, so the
  // place is named. Only Jay's site: the test site's database was moved to US West (scripts/move-d1.mjs)
  // and it turns this off below; the sites in sites.json drop it (scripts/site-config.mjs), their
  // databases are in US West too.
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },

  // Test site: its own Worker, database, domain and Telegram bot. Every merge to main lands here;
  // production only changes when a v* release tag is pushed (see .github/workflows/ci.yml).
  "env": {
    "staging": {
      "name": "jaysbadminton-staging",
      // Its database is in US West, where the visitors are: run wherever the visitor is.
      "placement": { "mode": "off" },
      "assets": {
        "directory": "./dist/web",
        "binding": "ASSETS",
        "run_worker_first": [
          "/",
          "/e/*",
          "/robots.txt",
          "/manifest.webmanifest",
          "/.well-known/*",
          "/api/*",
          "/export/*"
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jaysbadminton-staging",
          // Filled in by CI like the production one above.
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "SITE_ORIGIN": "https://staging.jaysbadminton.llmat.dev",
        "ENVIRONMENT": "staging",
        "ORGANIZERS": "1",
        // 总入口 (src/worker/hub.ts): on the test site only for now; a production site gets it when
        // Ke Li turns that group on.
        "HUB_ORIGIN": "https://badminton.llmat.dev",
        "SPONSOR_NAME": "Z3 Enterprise",
        "SPONSOR_URL": "https://www.z3enterprise.com/"
      },
      "durable_objects": {
        "bindings": [
          { "name": "DEADLINES", "class_name": "DeadlineAlarm" },
          { "name": "PUSH", "class_name": "PushSender" }
        ]
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "routes": [{ "pattern": "staging.jaysbadminton.llmat.dev", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
