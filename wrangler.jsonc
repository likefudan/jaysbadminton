{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaysbadminton",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/e/*", "/robots.txt", "/api/*", "/export/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaysbadminton",
      // Filled in by CI from the account's D1 database list; this placeholder works for local dev and tests.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // ORGANIZERS: the 组织者 features stay off in production until they have been tried on staging
  // (docs/launch-checklist.md, section 五). Local dev turns them on with ORGANIZERS="1" in .dev.vars.
  "vars": { "SITE_ORIGIN": "https://jaysbadminton.llmat.dev", "ENVIRONMENT": "production", "ORGANIZERS": "0" },
  // 截止前提醒 and 报名截止 go out on time from each event's alarm (src/worker/deadlines.ts).
  "durable_objects": { "bindings": [{ "name": "DEADLINES", "class_name": "DeadlineAlarm" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeadlineAlarm"] }],
  // Every 15 minutes: the hourly and daily jobs (settle reminder, dunning, digest) and a backstop
  // for any alarm that failed. Every job is logged in notification_log, so nothing is sent twice.
  "triggers": { "crons": ["*/15 * * * *"] },
  "routes": [{ "pattern": "jaysbadminton.llmat.dev", "custom_domain": true }],
  "observability": { "enabled": true },

  // Test site: its own Worker, database, domain and Telegram bot. Every merge to main lands here;
  // production only changes when a v* release tag is pushed (see .github/workflows/ci.yml).
  "env": {
    "staging": {
      "name": "jaysbadminton-staging",
      "assets": {
        "directory": "./dist/web",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/", "/e/*", "/robots.txt", "/api/*", "/export/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "jaysbadminton-staging",
          // Filled in by CI like the production one above.
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "SITE_ORIGIN": "https://staging.jaysbadminton.llmat.dev", "ENVIRONMENT": "staging", "ORGANIZERS": "1" },
      "durable_objects": { "bindings": [{ "name": "DEADLINES", "class_name": "DeadlineAlarm" }] },
      "triggers": { "crons": ["*/15 * * * *"] },
      "routes": [{ "pattern": "staging.jaysbadminton.llmat.dev", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
