{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jaysbadminton",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/export/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jaysbadminton",
      // Filled in by CI from the account's D1 database list; this placeholder works for local dev and tests.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "SITE_ORIGIN": "https://jaysbadminton.llmat.dev" },
  "triggers": { "crons": ["*/10 * * * *"] },
  "routes": [{ "pattern": "jaysbadminton.llmat.dev", "custom_domain": true }],
  "observability": { "enabled": true }
}
